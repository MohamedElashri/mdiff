{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mdiff",
  "version": "0.1.0",
  "identifier": "app.mdiff.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 1420 --strictPort",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mdiff",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; worker-src 'self' blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "A focused workspace for code review",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../LICENCE.md": "licenses/LICENCE.md"
    },
    "license": "GPL-3.0-only"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyNkMyOTlGRjA2OEE5QkQKUldTOXFXandueWxzTWkzL2V4ODg5Uk92QXR0TjhzKzIwSVd3ZnVRcDlDQnJsNWFTU0V1MHI4ZHgK",
      "endpoints": [
        "https://github.com/MohamedElashri/mdiff/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
