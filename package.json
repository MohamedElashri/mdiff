{
  "name": "mdiff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run build:desktop",
    "tauri": "tauri",
    "format": "prettier --write src package.json tsconfig.json src-tauri/tauri.conf.json",
    "check": "npm run build && npm run typecheck --prefix vendor/diffle && npm run test:review && cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "build:desktop": "tsc && vite build",
    "build:review": "npm run build --prefix vendor/diffle",
    "setup": "npm ci && npm ci --prefix vendor/diffle",
    "test:review": "npm test --prefix vendor/diffle",
    "test:engine": "cargo test --manifest-path vendor/diffle/Cargo.toml"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/source-code-pro": "^5.3.1",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@pierre/diffs": "1.6.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "commander": "^15.0.0",
    "lucide-react": "^1.61.0",
    "picomatch": "^4.0.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0",
    "vite": "^8.3.5"
  },
  "license": "GPL-3.0-only",
  "description": "Native code review for macOS and Linux",
  "repository": {
    "type": "git",
    "url": "https://github.com/MohamedElashri/mdiff.git"
  },
  "homepage": "https://github.com/MohamedElashri/mdiff",
  "bugs": {
    "url": "https://github.com/MohamedElashri/mdiff/issues"
  }
}
